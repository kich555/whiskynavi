# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.superpowers/

# graphify (local knowledge graph cache)
graphify-out/
graphify-out.bak.*/

# codegraph (local symbol index)
.codegraph/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# jetbrain-tools
.idea

# 개인 로컬 에이전트/스킬 (팀 공유 아님)
.agents/
skills-lock.json

# .claude/ 전체 무시 + 팀 공유 파일만 예외 (하네스 인프라)
.claude/*
!.claude/settings.json
!.claude/scripts/
.claude/scripts/.pending-doc-groups
.claude/scripts/.last-doc-commit
.claude/scripts/.logs/
